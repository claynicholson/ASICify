**/.pnpm-store
**/.next
**/.turbo
**/dist
**/build
**/*.tsbuildinfo

# Python (not needed for the web app image)
**/__pycache__
**/.venv
**/.uv
**/.mypy_cache
**/.ruff_cache
**/.pytest_cache
apps/api
apps/worker

# Local infra
infra
.env
.env.*
!.env.example

# Editor + OS
.vscode
.idea
.DS_Store
Thumbs.db

