// Hardwired weight constants — one entry per linear layer.
// Generated by ASICify. Synthesis will fold these into multiplier inputs:
//   binary  → XNOR + popcount
//   ternary → sign-flip mux + zero-out
//   int4    → CSD shift-add network (≤ 2 nonzero digits)
//   int8    → Booth multiplier
//   fp16    → small ROM-LUT per multiply

{% for layer in linear_layers %}
// {{ layer.name }} — {{ layer.in_features }} × {{ layer.out_features }}
// Effective bits/weight: {{ {'fp16':16,'int8':8,'int4':4,'ternary':1.6,'binary':1}[config.quantization] }}
// Sparsity mask:  {{ 'present' if layer.name in graph.sparsity_masks else 'none' }}
// (full constant array elided — populated by `asicify pack-weights` step)
localparam logic [({{ {'fp16':16,'int8':8,'int4':4,'ternary':2,'binary':1}[config.quantization] }})-1:0]
    W_{{ layer.name | replace('.', '_') }}[0:{{ layer.out_features - 1 }}][0:{{ layer.in_features - 1 }}] = '{default: '0};

{% endfor %}

// Embedding tables (if present)
{% for layer in graph.layers if layer.kind == 'embedding' %}
localparam logic [7:0] EMBED_{{ layer.name | replace('.', '_') }}[0:{{ layer.in_features - 1 }}][0:{{ layer.out_features - 1 }}] = '{default: '0};
{% endfor %}
