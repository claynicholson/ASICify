"""Cocotb testbench for {{ graph.name }}.

Drives random inputs through the RTL, compares output to the Python reference,
which is bit-exact for deterministic operations.
"""

import random

import cocotb
from cocotb.clock import Clock
from cocotb.triggers import RisingEdge, Timer

from reference import reference_forward


@cocotb.test()
async def smoke(dut):
    cocotb.start_soon(Clock(dut.clk, 10, units="ns").start())
    dut.rst_n.value = 0
    dut.in_valid.value = 0
    dut.out_ready.value = 1
    await Timer(50, units="ns")
    dut.rst_n.value = 1
    await Timer(50, units="ns")

    inputs = [random.randint(0, 255) for _ in range(64)]
    expected = reference_forward(inputs)

    actual = []
    for x in inputs:
        dut.in_data.value = x
        dut.in_valid.value = 1
        await RisingEdge(dut.clk)
        if int(dut.out_valid.value):
            actual.append(int(dut.out_data.value))
    dut.in_valid.value = 0

    # Bit-exactness check (deterministic ops only)
    for i, (a, e) in enumerate(zip(actual, expected)):
        assert a == e, f"mismatch at {i}: got {a}, expected {e}"
