// {{ layer_view.name }}
// in_features = {{ layer_view.in_features }}
// out_features = {{ layer_view.out_features }}
// Quantization: {{ layer_view.quantization }}
// Multiplier strategy: {{ multiplier }}
//
// Computes:
//   acc[o]   = bias_q[o] + sum_i  x[i] * unpack(W[o], i)    (signed int32)
//   y_q63[o] = acc[o] * SCALE_Q31[o]                         (signed 64-bit)
//   y[o]     = y_q63[o] >>> 31                               (arith. right shift)
//
// The `unpack(W[o], i)` operator depends on multiplier strategy:
//   booth         (INT8): W[o][i] is already an 8-bit signed value
//   csd_shift_add (INT4): unpack low/high nibble from W[o][i/2], sign-extend 4->32
//   sign_flip_mux (TER) : decode 2-bit code from W[o][i/4][2*(i%4) +: 2]
//   xnor_popcount (BIN) : bit i of W[o][i/8], -1 if 0 else +1

`default_nettype none

module layer_{{ layer_view.symbol }} (
    input  wire                          clk,
    input  wire                          rst_n,

    input  wire                          in_valid,
    output wire                          in_ready,
    input  wire signed [7:0]             in_data,

    output reg                           out_valid,
    input  wire                          out_ready,
    output reg  signed [31:0]            out_data
);

    localparam int IN_FEATURES  = {{ layer_view.in_features }};
    localparam int OUT_FEATURES = {{ layer_view.out_features }};

    `include "weights.vh"

    reg signed [31:0] acc [0:OUT_FEATURES-1];
    reg [$clog2(IN_FEATURES+1)-1:0] in_idx;
    reg [$clog2(OUT_FEATURES+1)-1:0] out_idx;
    reg streaming;

    assign in_ready = ~streaming;

    integer o;
    reg signed [63:0] product;
    reg signed [63:0] rescaled;
    reg signed [7:0]  w_unpacked;

    // ------------------------------------------------------------------
    // unpack_w(wo, wi) returns the signed-extended weight at row wo, col wi.
    // The function body changes per multiplier strategy.
    // ------------------------------------------------------------------
    function automatic signed [7:0] unpack_w (input integer wo, input integer wi);
        reg [7:0] byte_val;
        reg [3:0] nibble;
        reg [1:0] code;
        reg       bit_val;
        begin
{% if multiplier == 'booth' %}
            unpack_w = W_{{ layer_view.symbol }}[wo][wi];
{% elif multiplier == 'csd_shift_add' %}
            byte_val = W_{{ layer_view.symbol }}[wo][wi >> 1];
            nibble = (wi[0] == 1'b0) ? byte_val[3:0] : byte_val[7:4];
            // Sign-extend 4 -> 8 bits.
            unpack_w = {{ '{{4{nibble[3]}}' }}, nibble };
{% elif multiplier == 'sign_flip_mux' %}
            byte_val = W_{{ layer_view.symbol }}[wo][wi >> 2];
            code = byte_val >> (2 * (wi[1:0]));
            unpack_w = (code == 2'b00) ?  8'sd0  :
                       (code == 2'b01) ?  8'sd1  :
                                         -8'sd1;
{% elif multiplier == 'xnor_popcount' %}
            byte_val = W_{{ layer_view.symbol }}[wo][wi >> 3];
            bit_val = byte_val[wi[2:0]];
            unpack_w = bit_val ? 8'sd1 : -8'sd1;
{% elif multiplier == 'fp16_lut' %}
            // FP16 is handled in a different code path; this branch is here
            // only because the function signature is shared. The fp16 module
            // overrides the entire body below.
            unpack_w = 8'sd0;
{% else %}
            unpack_w = W_{{ layer_view.symbol }}[wo][wi];
{% endif %}
        end
    endfunction

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            in_idx    <= '0;
            out_idx   <= '0;
            out_valid <= 1'b0;
            out_data  <= '0;
            streaming <= 1'b0;
            for (o = 0; o < OUT_FEATURES; o = o + 1) begin
                acc[o] <= 32'sd0;
            end
        end else if (!streaming) begin
            // Drop out_valid once the final streamed word has been consumed;
            // otherwise it sticks high with stale data and the next stage
            // reads phantom inputs between bursts.
            if (out_valid && out_ready) begin
                out_valid <= 1'b0;
            end
            if (in_valid) begin
                // Bias folds in on the first MAC of each vector, so reset can
                // clear acc to a constant instead of reading the BIAS ROM
                // (a non-constant async-reset value upsets synthesis).
                for (o = 0; o < OUT_FEATURES; o = o + 1) begin
                    w_unpacked = unpack_w(o, in_idx);
                    if (in_idx == 0) begin
{% if layer_view.has_bias %}
                        acc[o] <= BIAS_Q_{{ layer_view.symbol }}[o]
                                  + $signed(in_data) * $signed(w_unpacked);
{% else %}
                        acc[o] <= $signed(in_data) * $signed(w_unpacked);
{% endif %}
                    end else begin
                        acc[o] <= acc[o] + $signed(in_data) * $signed(w_unpacked);
                    end
                end

                if (in_idx == IN_FEATURES - 1) begin
                    in_idx    <= '0;
                    out_idx   <= '0;
                    streaming <= 1'b1;
                end else begin
                    in_idx <= in_idx + 1;
                end
            end
        end else begin
            if (!out_valid || out_ready) begin
                // acc must sign-extend to 64 bits: both operands signed, the
                // 64-bit assignment context extends them. A {32'sd0, acc}
                // concat would zero-extend and corrupt negative accumulators.
                product  = $signed(acc[out_idx]) *
                           $signed({1'b0, SCALE_Q31_{{ layer_view.symbol }}[out_idx]});
                rescaled = product >>> 31;
                out_data  <= rescaled[31:0];
                out_valid <= 1'b1;

                if (out_idx == OUT_FEATURES - 1) begin
                    streaming <= 1'b0;
                    out_idx   <= '0;
                end else begin
                    out_idx <= out_idx + 1;
                end
            end
        end
    end

endmodule

`default_nettype wire
