// Integer softmax with LUT-based exp.
//
// Streaming protocol:
//   1. Collect SEQ_LEN int32 logits.
//   2. Find max, compute d = logits - max (each in [-(N-1), 0]).
//   3. Look up exp_q15 from SOFTMAX_LUT.
//   4. Sum the exp values.
//   5. Normalize: weights_q15[t] = (exp_q15[t] << 15) / sum
//   6. Stream out the SEQ_LEN int32 weights.

`default_nettype none

module softmax #(
    parameter int SEQ_LEN = 64,
    parameter int LUT_SIZE = 256
) (
    input  wire                          clk,
    input  wire                          rst_n,

    input  wire                          in_valid,
    output wire                          in_ready,
    input  wire signed [31:0]            in_logit,

    output reg                           out_valid,
    input  wire                          out_ready,
    output reg  signed [31:0]            out_weight
);

    `include "weights.vh"  // expects SOFTMAX_LUT[0:LUT_SIZE-1] (Q15)

    reg signed [31:0] logits [0:SEQ_LEN-1];
    reg signed [31:0] exp_q15 [0:SEQ_LEN-1];
    reg signed [31:0] max_logit;
    reg signed [63:0] sum_exp;
    reg [$clog2(SEQ_LEN+1)-1:0] in_idx;
    reg [$clog2(SEQ_LEN+1)-1:0] out_idx;
    reg [1:0] state;  // 0 collect, 1 max+exp, 2 normalize, 3 stream

    integer t;
    reg signed [31:0] d;
    reg [$clog2(LUT_SIZE):0] lut_idx;

    assign in_ready = (state == 2'd0);

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            in_idx    <= '0;
            out_idx   <= '0;
            out_valid <= 1'b0;
            state     <= 2'd0;
        end else if (state == 2'd0) begin
            if (in_valid) begin
                logits[in_idx] <= in_logit;
                if (in_idx == SEQ_LEN - 1) begin
                    in_idx <= '0;
                    state <= 2'd1;
                end else begin
                    in_idx <= in_idx + 1;
                end
            end
        end else if (state == 2'd1) begin
            // Find max in one cycle (combinational tree in real silicon).
            max_logit = logits[0];
            for (t = 1; t < SEQ_LEN; t = t + 1) begin
                if (logits[t] > max_logit) max_logit = logits[t];
            end
            sum_exp = 0;
            for (t = 0; t < SEQ_LEN; t = t + 1) begin
                d = logits[t] - max_logit;
                if (d < -(LUT_SIZE - 1)) d = -(LUT_SIZE - 1);
                lut_idx = d + (LUT_SIZE - 1);
                exp_q15[t] <= SOFTMAX_LUT[lut_idx];
                sum_exp = sum_exp + SOFTMAX_LUT[lut_idx];
            end
            state <= 2'd2;
        end else if (state == 2'd2) begin
            for (t = 0; t < SEQ_LEN; t = t + 1) begin
                exp_q15[t] <= ($signed({exp_q15[t], 15'd0})) /
                              ((sum_exp == 0) ? 64'sd1 : sum_exp);
            end
            state <= 2'd3;
            out_idx <= '0;
        end else begin
            if (!out_valid || out_ready) begin
                out_weight <= exp_q15[out_idx];
                out_valid <= 1'b1;
                if (out_idx == SEQ_LEN - 1) begin
                    state <= 2'd0;
                    out_idx <= '0;
                end else begin
                    out_idx <= out_idx + 1;
                end
            end
        end
    end

endmodule

`default_nettype wire
