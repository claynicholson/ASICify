// {{ layer.name }} — token embedding lookup
// Mask-ROM addressed by token id, returns hidden vector.

`default_nettype none

module {{ layer.name | replace('.', '_') }} #(
    parameter integer DATA_WIDTH = 8,
    parameter integer VOCAB_SIZE = {{ layer.in_features }},
    parameter integer HIDDEN     = {{ layer.out_features }}
) (
    input  wire                       clk,
    input  wire                       rst_n,
    input  wire                       in_valid,
    output wire                       in_ready,
    input  wire [$clog2(VOCAB_SIZE)-1:0] in_data,
    output reg                        out_valid,
    input  wire                       out_ready,
    output reg  [DATA_WIDTH-1:0]      out_data
);
    `include "weights/weights.vh"

    assign in_ready = 1'b1;

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            out_valid <= 1'b0;
            out_data  <= '0;
        end else if (in_valid) begin
            // ROM lookup
            out_data  <= EMBED_{{ layer.name | replace('.', '_') }}[in_data][0]; // first hidden dim sample
            out_valid <= 1'b1;
        end else if (out_valid && out_ready) begin
            out_valid <= 1'b0;
        end
    end

endmodule

`default_nettype wire
