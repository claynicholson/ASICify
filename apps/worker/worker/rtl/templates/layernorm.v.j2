// {{ layer_view.name }} (LayerNorm, dim={{ layer_view.dim }})
//
// Streaming protocol:
//   1. Collect DIM int8 elements into a buffer.
//   2. Compute mean, variance, inv_std (Q15).
//   3. Apply (x - mean) * inv_std * gamma + beta, saturate to int8.
//   4. Stream out the DIM-element result.
//
// gamma_q15 / beta_q15 / eps_q15 are hardwired in weights.vh.
// inv_sqrt is implemented with a Verilator-DPI real-math helper for
// simulation; for ASIC synthesis a small LUT replaces this function.

`default_nettype none

module layer_{{ layer_view.symbol }} (
    input  wire                          clk,
    input  wire                          rst_n,

    input  wire                          in_valid,
    output wire                          in_ready,
    input  wire signed [7:0]             in_data,

    output reg                           out_valid,
    input  wire                          out_ready,
    output reg  signed [7:0]             out_data
);

    localparam int DIM = {{ layer_view.dim }};

    `include "weights.vh"

    reg signed [31:0] buffer [0:DIM-1];
    reg [$clog2(DIM+1)-1:0] in_idx;
    reg [$clog2(DIM+1)-1:0] out_idx;
    reg [1:0] state;  // 0 collecting, 1 normalizing, 2 streaming

    assign in_ready = (state == 2'd0);

    integer i;
    reg signed [63:0] sum_x;
    reg signed [63:0] sum_x2;
    reg signed [31:0] mean;
    reg signed [31:0] variance;
    reg signed [31:0] inv_std_q15;
    reg signed [31:0] centered;
    reg signed [63:0] norm_q15;
    reg signed [63:0] y_q15;

    function automatic signed [31:0] inv_sqrt_q15 (input signed [31:0] var_in);
        real var_real;
        real inv;
        begin
            var_real = $itor(var_in);
            if (var_real <= 0.0) var_real = 1.0;
            inv = 1.0 / $sqrt(var_real);
            inv_sqrt_q15 = $rtoi(inv * 32768.0);
        end
    endfunction

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            in_idx    <= '0;
            out_idx   <= '0;
            out_valid <= 1'b0;
            out_data  <= '0;
            state     <= 2'd0;
        end else if (state == 2'd0) begin
            if (in_valid) begin
                buffer[in_idx] <= in_data;
                if (in_idx == DIM - 1) begin
                    in_idx <= '0;
                    state <= 2'd1;
                end else begin
                    in_idx <= in_idx + 1;
                end
            end
        end else if (state == 2'd1) begin
            sum_x = 0;
            for (i = 0; i < DIM; i = i + 1) sum_x = sum_x + buffer[i];
            mean = sum_x / DIM;

            sum_x2 = 0;
            for (i = 0; i < DIM; i = i + 1) begin
                centered = buffer[i] - mean;
                sum_x2 = sum_x2 + centered * centered;
            end
            variance = (sum_x2 / DIM) + (EPS_Q15_{{ layer_view.symbol }} >>> 15);
            inv_std_q15 = inv_sqrt_q15(variance);

            for (i = 0; i < DIM; i = i + 1) begin
                centered = buffer[i] - mean;
                norm_q15 = ($signed(centered) * inv_std_q15) >>> 15;
                y_q15 = (norm_q15 * GAMMA_Q15_{{ layer_view.symbol }}[i]
                         + BETA_Q15_{{ layer_view.symbol }}[i]) >>> 15;
                if (y_q15 > 127)        buffer[i] <=  127;
                else if (y_q15 < -128)  buffer[i] <= -128;
                else                    buffer[i] <= y_q15[7:0];
            end
            out_idx <= '0;
            state <= 2'd2;
        end else begin
            if (!out_valid || out_ready) begin
                out_data <= buffer[out_idx][7:0];
                out_valid <= 1'b1;
                if (out_idx == DIM - 1) begin
                    state <= 2'd0;
                    out_idx <= '0;
                end else begin
                    out_idx <= out_idx + 1;
                end
            end
        end
    end

endmodule

`default_nettype wire
