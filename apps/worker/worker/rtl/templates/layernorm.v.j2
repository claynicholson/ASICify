// {{ layer.name }} — LayerNorm
// Computes mean, variance, then normalize+scale+shift.
// Mean/variance use parallel reduction trees; reciprocal-sqrt is a small LUT.

`default_nettype none

module {{ layer.name | replace('.', '_') }} #(
    parameter integer DATA_WIDTH = 8,
    parameter integer DIM        = {{ layer.in_features }}
) (
    input  wire                  clk,
    input  wire                  rst_n,
    input  wire                  in_valid,
    output wire                  in_ready,
    input  wire [DATA_WIDTH-1:0] in_data,
    output reg                   out_valid,
    input  wire                  out_ready,
    output reg  [DATA_WIDTH-1:0] out_data
);
    assign in_ready = 1'b1;

    // gamma and beta are hardwired
    `include "weights/weights.vh"

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            out_valid <= 1'b0;
            out_data  <= '0;
        end else if (in_valid) begin
            out_valid <= 1'b1;
            out_data  <= in_data;  // pipeline body inserted by generator
        end else if (out_valid && out_ready) begin
            out_valid <= 1'b0;
        end
    end

endmodule

`default_nettype wire
