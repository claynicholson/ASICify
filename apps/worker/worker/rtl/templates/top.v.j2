// ASICify generated top-level wrapper
// Model:        {{ graph.name }}
// Quantization: {{ config.quantization }}
// Sparsity:     {{ config.sparsity.type }} ({{ config.sparsity.ratio }})
// Decomposition:{{ config.decomposition.type }}
// Multipliers:  {{ multiplier }}
// Generated by ASICify v0.1.0

`default_nettype none

module top #(
    parameter integer DATA_WIDTH = {{ {'fp16':16,'int8':8,'int4':4,'ternary':2,'binary':1}[config.quantization] }},
    parameter integer ACC_WIDTH  = 32
) (
    input  wire                       clk,
    input  wire                       rst_n,
    input  wire                       in_valid,
    output wire                       in_ready,
    input  wire [DATA_WIDTH-1:0]      in_data,
    output wire                       out_valid,
    input  wire                       out_ready,
    output wire [DATA_WIDTH-1:0]      out_data
);

    // Pipeline interconnect signals
    {% for i in range(graph.layers|length) %}
    wire [DATA_WIDTH-1:0] stage_{{ i }}_data;
    wire                  stage_{{ i }}_valid;
    wire                  stage_{{ i }}_ready;
    {% endfor %}

    // Layer instances (pipelined dataflow)
    {% for layer in graph.layers %}
    {% if layer.kind in ('linear','ffn','attention','layernorm','embedding') %}
    {{ layer.name | replace('.', '_') }} #(.DATA_WIDTH(DATA_WIDTH)) u_{{ loop.index0 }} (
        .clk      (clk),
        .rst_n    (rst_n),
        .in_valid ({% if loop.first %}in_valid{% else %}stage_{{ loop.index0 - 1 }}_valid{% endif %}),
        .in_ready ({% if loop.first %}in_ready{% else %}stage_{{ loop.index0 - 1 }}_ready{% endif %}),
        .in_data  ({% if loop.first %}in_data{% else %}stage_{{ loop.index0 - 1 }}_data{% endif %}),
        .out_valid(stage_{{ loop.index0 }}_valid),
        .out_ready(stage_{{ loop.index0 }}_ready),
        .out_data (stage_{{ loop.index0 }}_data)
    );
    {% endif %}
    {% endfor %}

    assign out_data  = stage_{{ graph.layers|length - 1 }}_data;
    assign out_valid = stage_{{ graph.layers|length - 1 }}_valid;
    assign stage_{{ graph.layers|length - 1 }}_ready = out_ready;

endmodule

`default_nettype wire
