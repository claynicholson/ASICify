// ASICify top-level wrapper for {{ graph.name }}.
//
// Pipeline order:
{% for view in pipeline %}
//   stage {{ loop.index0 }}: {{ view.name }}  ({{ view.in_features }} -> {{ view.out_features }})
{% endfor %}
//
// Activations between layers stream as signed int8. Each layer outputs a
// signed int32 (rescaled accumulator); a clip stage truncates to int8 before
// feeding the next layer. The clip is inline here in the top wrapper.

`default_nettype none

module top (
    input  wire                  clk,
    input  wire                  rst_n,

    input  wire                  in_valid,
    output wire                  in_ready,
    input  wire signed [7:0]     in_data,

    output wire                  out_valid,
    input  wire                  out_ready,
    output wire signed [31:0]    out_data
);

{% if pipeline %}
{% for view in pipeline %}
    wire                          s{{ loop.index0 }}_in_valid;
    wire                          s{{ loop.index0 }}_in_ready;
    wire signed [7:0]             s{{ loop.index0 }}_in_data;
    wire                          s{{ loop.index0 }}_out_valid;
    wire                          s{{ loop.index0 }}_out_ready;
    wire signed [31:0]            s{{ loop.index0 }}_out_data;

    layer_{{ view.symbol }} u_{{ view.symbol }} (
        .clk      (clk),
        .rst_n    (rst_n),
        .in_valid (s{{ loop.index0 }}_in_valid),
        .in_ready (s{{ loop.index0 }}_in_ready),
        .in_data  (s{{ loop.index0 }}_in_data),
        .out_valid(s{{ loop.index0 }}_out_valid),
        .out_ready(s{{ loop.index0 }}_out_ready),
        .out_data (s{{ loop.index0 }}_out_data)
    );

{% endfor %}

    // Wire the first stage to the top-level inputs.
    assign s0_in_valid = in_valid;
    assign in_ready    = s0_in_ready;
    assign s0_in_data  = in_data;

{% if pipeline|length > 1 %}
    // Inter-stage clipping: int32 from layer N -> int8 into layer N+1.
{% for view in pipeline %}
{% if not loop.first %}
    assign s{{ loop.index0 }}_in_valid = s{{ loop.index0 - 1 }}_out_valid;
    assign s{{ loop.index0 - 1 }}_out_ready = s{{ loop.index0 }}_in_ready;
    // Saturating clip to int8.
    assign s{{ loop.index0 }}_in_data =
        (s{{ loop.index0 - 1 }}_out_data >  32'sd127)  ?  8'sd127  :
        (s{{ loop.index0 - 1 }}_out_data < -32'sd128)  ? -8'sd128  :
        s{{ loop.index0 - 1 }}_out_data[7:0];
{% endif %}
{% endfor %}
{% endif %}

    // Last stage drives the top-level output (un-clipped int32).
    assign out_valid = s{{ pipeline|length - 1 }}_out_valid;
    assign s{{ pipeline|length - 1 }}_out_ready = out_ready;
    assign out_data  = s{{ pipeline|length - 1 }}_out_data;

{% else %}
    // No linear layers in the parsed graph. Pass-through.
    assign in_ready  = out_ready;
    assign out_valid = in_valid;
    assign out_data  = {{ '{24{in_data[7]}}' }};  // sign-extend int8 to int32
{% endif %}

endmodule

`default_nettype wire
