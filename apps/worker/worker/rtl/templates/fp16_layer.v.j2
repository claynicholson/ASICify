// {{ layer_view.name }}
// in_features = {{ layer_view.in_features }}
// out_features = {{ layer_view.out_features }}
// Quantization: fp16
//
// FP16 path. The accumulator is 32-bit float (single precision) for
// numerical safety; weights and activations are fp16.
//
// Computes:
//   acc[o] = sum_i  fp16_to_fp32(x[i]) * fp16_to_fp32(W[o][i])
//   y[o]   = round(acc[o] + bias[o]) as int32                      (saturating)
//
// Verilator supports the IEEE-754 conversions via $bitstoshortreal /
// $shortrealtobits. Real ASIC synthesis would map to a fp16 multiplier
// macro from the cell library; here we use behavioral float to keep the
// reference simple and bit-exact against PyTorch's float16 dtype.

`default_nettype none

module layer_{{ layer_view.symbol }} (
    input  wire                          clk,
    input  wire                          rst_n,

    input  wire                          in_valid,
    output wire                          in_ready,
    input  wire signed [7:0]             in_data,            // int8 for inter-stage compat

    output reg                           out_valid,
    input  wire                          out_ready,
    output reg  signed [31:0]            out_data
);

    localparam int IN_FEATURES  = {{ layer_view.in_features }};
    localparam int OUT_FEATURES = {{ layer_view.out_features }};

    `include "weights.vh"

    // Accumulator stored as float32 bit pattern.
    reg [31:0] acc_bits [0:OUT_FEATURES-1];
    reg [$clog2(IN_FEATURES+1)-1:0] in_idx;
    reg [$clog2(OUT_FEATURES+1)-1:0] out_idx;
    reg streaming;

    assign in_ready = ~streaming;

    integer o;
    real x_fp32, w_fp32, prod, acc_fp32;
    real bias_fp32;

    // Convert int8 input to float for the multiply.
    function automatic real int8_to_real (input signed [7:0] v);
        int8_to_real = $itor(v);
    endfunction

    // FP16 -> FP32 widening. Verilator implements IEEE-754 conversion via
    // $bitstoshortreal on a 16-bit value packed into 32 bits.
    function automatic real fp16_to_real (input [15:0] bits16);
        // Manually decode a half-precision float into a real.
        // sign: bits16[15], exp: bits16[14:10], frac: bits16[9:0]
        real m, e, sign;
        begin
            sign = (bits16[15]) ? -1.0 : 1.0;
            if (bits16[14:10] == 5'd0) begin
                // subnormal or zero
                m = $itor(bits16[9:0]) / 1024.0;  // 2^10
                fp16_to_real = sign * m * (1.0 / 16384.0);  // 2^-14
            end else if (bits16[14:10] == 5'd31) begin
                // inf or NaN -> treat as 0 for safety in simulation
                fp16_to_real = 0.0;
            end else begin
                m = 1.0 + $itor(bits16[9:0]) / 1024.0;
                e = $itor($signed({1'b0, bits16[14:10]}) - 15);
                fp16_to_real = sign * m * (2.0 ** e);
            end
        end
    endfunction

    function automatic [31:0] real_to_int32 (input real r);
        real clipped;
        begin
            clipped = r;
            if (clipped >  2147483647.0) clipped =  2147483647.0;
            if (clipped < -2147483648.0) clipped = -2147483648.0;
            real_to_int32 = $rtoi(clipped);
        end
    endfunction

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            in_idx    <= '0;
            out_idx   <= '0;
            out_valid <= 1'b0;
            out_data  <= '0;
            streaming <= 1'b0;
            for (o = 0; o < OUT_FEATURES; o = o + 1) begin
                acc_bits[o] <= 32'd0;
            end
        end else if (!streaming) begin
            if (in_valid) begin
                x_fp32 = int8_to_real(in_data);
                for (o = 0; o < OUT_FEATURES; o = o + 1) begin
                    w_fp32 = fp16_to_real(W_{{ layer_view.symbol }}[o][in_idx]);
                    prod = x_fp32 * w_fp32;
                    acc_fp32 = $bitstoshortreal(acc_bits[o]) + prod;
                    acc_bits[o] <= $shortrealtobits(acc_fp32);
                end
                if (in_idx == IN_FEATURES - 1) begin
                    in_idx    <= '0;
                    out_idx   <= '0;
                    streaming <= 1'b1;
                end else begin
                    in_idx <= in_idx + 1;
                end
            end
        end else begin
            if (!out_valid || out_ready) begin
                acc_fp32  = $bitstoshortreal(acc_bits[out_idx]);
                out_data  <= real_to_int32(acc_fp32);
                out_valid <= 1'b1;
                if (out_idx == OUT_FEATURES - 1) begin
                    streaming <= 1'b0;
                    out_idx   <= '0;
                    for (o = 0; o < OUT_FEATURES; o = o + 1) begin
                        acc_bits[o] <= 32'd0;
                    end
                end else begin
                    out_idx <= out_idx + 1;
                end
            end
        end
    end

endmodule

`default_nettype wire
