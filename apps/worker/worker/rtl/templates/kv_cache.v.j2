// KV cache — addressable BRAM with read/write port
// Used by attention layers across decode steps.

`default_nettype none

module kv_cache #(
    parameter integer DATA_WIDTH = 8,
    parameter integer DEPTH      = 2048,
    parameter integer HIDDEN     = 768
) (
    input  wire                       clk,
    input  wire                       wr_en,
    input  wire [$clog2(DEPTH)-1:0]   wr_addr,
    input  wire [HIDDEN*DATA_WIDTH-1:0] wr_data,
    input  wire [$clog2(DEPTH)-1:0]   rd_addr,
    output reg  [HIDDEN*DATA_WIDTH-1:0] rd_data
);
    reg [HIDDEN*DATA_WIDTH-1:0] mem [0:DEPTH-1];

    always @(posedge clk) begin
        if (wr_en) mem[wr_addr] <= wr_data;
        rd_data <= mem[rd_addr];
    end

endmodule

`default_nettype wire
