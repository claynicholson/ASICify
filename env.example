# Copy to .env at the project root and fill in values.

# ----- Database -----
DATABASE_URL=postgresql+asyncpg://asicify:asicify@localhost:5432/asicify

# ----- Redis -----
REDIS_URL=redis://localhost:6379/0

# ----- Cloudflare R2 (or MinIO locally) -----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET=asicify-artifacts
R2_ENDPOINT=http://localhost:9000
R2_PUBLIC_URL=

# ----- Clerk -----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_ISSUER=

# ----- Modal (production worker) -----
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ----- API base -----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ----- Sentry -----
SENTRY_DSN=

# ----- Feature flags -----
ENABLE_HARDWARE_AWARE_FT=false
