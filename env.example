# Copy to .env at the project root and fill in values.
#
# The web app does not need any of these to run. They are for the API and
# worker, which are not yet deployed and not required for the playground or
# the markdown docs.

# ----- Database (apps/api) -----
DATABASE_URL=postgresql+asyncpg://asicify:asicify@localhost:5432/asicify

# ----- Redis (apps/api + apps/worker) -----
REDIS_URL=redis://localhost:6379/0

# ----- S3-compatible object store (apps/api + apps/worker) -----
# MinIO ships in infra/docker-compose.yml for local dev. Production uses
# Cloudflare R2 or AWS S3.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET=asicify-artifacts
R2_ENDPOINT=http://localhost:9000
R2_PUBLIC_URL=

# ----- Clerk (apps/api auth) -----
# Leave blank in dev. apps/api/app/auth.py falls back to an X-Dev-User-Id
# header when CLERK_JWT_KEY is unset.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_ISSUER=

# ----- Modal (apps/worker production compute) -----
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ----- Sentry (optional) -----
SENTRY_DSN=

# ----- Feature flags -----
ENABLE_HARDWARE_AWARE_FT=false
